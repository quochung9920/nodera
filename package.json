{
  "name": "nodera",
  "version": "0.1.0-alpha.5",
  "private": true,
  "description": "Nodera — AI-native WordPress Builder",
  "scripts": {
    "start": "wp-scripts start src/editor.tsx --output-path=build",
    "build:editor": "wp-scripts build src/editor.tsx --output-path=build",
    "build:modules": "wp-scripts build src/blocks/accordion-view.js src/blocks/tabs-view.js --output-path=build --experimental-modules",
    "build": "npm run build:editor && npm run build:modules",
    "typecheck": "tsc --noEmit",
    "lint:js": "wp-scripts lint-js src tests/unit tests/e2e",
    "lint:css": "wp-scripts lint-style src/**/*.css blocks/**/*.css",
    "test:unit": "wp-scripts test-unit-js --runInBand",
    "test:e2e": "playwright test",
    "check:runtime": "node --check build/editor.js && node --check build/accordion-view.js && node --check build/tabs-view.js",
    "check:quality": "npm run typecheck && npm run lint:js && npm run lint:css && npm run test:unit && npm run build && npm run check:runtime",
    "package": "node scripts/package.mjs",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@wordpress/scripts": "34.0.0",
    "archiver": "8.0.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@wordpress/api-fetch": "7.53.0",
    "@wordpress/block-editor": "16.2.0",
    "@wordpress/blocks": "15.26.0",
    "@wordpress/components": "39.0.0",
    "@wordpress/data": "10.52.0",
    "@wordpress/editor": "14.53.0",
    "@wordpress/element": "8.5.0",
    "@wordpress/hooks": "4.53.0",
    "@wordpress/i18n": "6.26.0",
    "@wordpress/interactivity": "6.51.0",
    "@wordpress/plugins": "7.53.0"
  }
}
