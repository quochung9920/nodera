{
  "name": "nodera",
  "version": "0.1.0-rc.4",
  "private": true,
  "description": "Nodera — AI-native WordPress Builder",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "wp-scripts start src/editor.tsx --output-path=build",
    "build:editor": "wp-scripts build src/editor.tsx --output-path=build",
    "build:modules": "wp-scripts build src/blocks/accordion-view.js src/blocks/tabs-view.js --output-path=build/modules --experimental-modules",
    "build:finalize": "node scripts/finalize-build.mjs",
    "build": "npm run build:editor && npm run build:modules && npm run build:finalize",
    "typecheck": "tsc --noEmit",
    "lint:js": "wp-scripts lint-js src",
    "lint:css": "wp-scripts lint-style src/**/*.css blocks/**/*.css",
    "test:unit": "wp-scripts test-unit-js --runInBand",
    "test:e2e": "playwright test",
    "verify:deps": "node scripts/verify-dependencies.mjs",
    "verify:lockfiles": "node scripts/verify-lockfiles.mjs",
    "verify:visual": "node scripts/verify-visual-fidelity.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "check:quality": "npm run verify:deps && npm run typecheck && npm run lint:js && npm run lint:css && npm run test:unit && npm run build && npm run verify:visual && npm run verify:runtime",
    "package": "node scripts/package.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "release:verify": "npm run check:quality && npm run package && npm run verify:package",
    "release:stable:verify": "npm run verify:lockfiles && npm run release:verify"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@wordpress/scripts": "34.1.0",
    "archiver": "8.0.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@wordpress/api-fetch": "7.54.0",
    "@wordpress/block-editor": "16.2.0",
    "@wordpress/blocks": "15.26.0",
    "@wordpress/components": "39.0.0",
    "@wordpress/data": "10.52.0",
    "@wordpress/editor": "14.53.0",
    "@wordpress/element": "8.5.0",
    "@wordpress/hooks": "4.53.0",
    "@wordpress/i18n": "6.26.0",
    "@wordpress/interactivity": "6.51.0",
    "@wordpress/plugins": "7.53.0"
  }
}
