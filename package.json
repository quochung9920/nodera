{
  "name": "nodera",
  "version": "0.1.0-rc.2",
  "private": true,
  "description": "Nodera — AI-native WordPress Builder",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "wp-scripts start src/editor.tsx --output-path=build",
    "build:editor": "wp-scripts build src/editor.tsx --output-path=build",
    "build:modules": "wp-scripts build src/blocks/accordion-view.js src/blocks/tabs-view.js --output-path=build/modules --experimental-modules",
    "build:finalize": "node scripts/finalize-build.mjs",
    "build": "npm run build:editor && npm run build:modules && npm run build:finalize",
    "typecheck": "tsc --noEmit",
    "lint:js": "wp-scripts lint-js src",
    "lint:css": "wp-scripts lint-style src/**/*.css blocks/**/*.css",
    "test:unit": "wp-scripts test-unit-js --runInBand",
    "test:e2e": "playwright test",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "check:quality": "npm run typecheck && npm run lint:js && npm run lint:css && npm run test:unit && npm run build && npm run verify:runtime",
    "package": "node scripts/package.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "release:verify": "npm run check:quality && npm run package && npm run verify:package"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@wordpress/scripts": "latest",
    "archiver": "latest",
    "typescript": "latest"
  },
  "dependencies": {
    "@wordpress/api-fetch": "latest",
    "@wordpress/block-editor": "latest",
    "@wordpress/blocks": "latest",
    "@wordpress/components": "latest",
    "@wordpress/data": "latest",
    "@wordpress/editor": "latest",
    "@wordpress/element": "latest",
    "@wordpress/hooks": "latest",
    "@wordpress/i18n": "latest",
    "@wordpress/interactivity": "latest",
    "@wordpress/plugins": "latest"
  }
}
